{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level brief v4 (kind: cityforge, schemaVersion: 4)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this brief schema: ./level-v4.schema.json."
    },
    "kind": {
      "type": "string",
      "enum": [
        "cityforge"
      ],
      "description": "CityForge v4 source brief with district generator manifest."
    },
    "schemaVersion": {
      "type": "number",
      "description": "Format version: v4 (district-aware generator)."
    },
    "metadata": {
      "$ref": "./level-common.schema.json#/definitions/metadata"
    },
    "ground": {
      "$ref": "./level-common.schema.json#/definitions/ground"
    },
    "gameplay": {
      "$ref": "./level-common.schema.json#/definitions/gameplay"
    },
    "stream": {
      "$ref": "./level-common.schema.json#/definitions/stream"
    },
    "windows": {
      "type": "object",
      "properties": {
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 12,
          "description": "м: ритм окон вдоль грани; 0 — дому окна не рисуются вовсе",
          "default": 3
        },
        "width": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 6,
          "description": "м: ширина квада",
          "default": 1.15
        },
        "height": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 6,
          "description": "м: высота квада",
          "default": 1.6
        },
        "sill": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "м: подоконник от пола этажа",
          "default": 0.9
        },
        "offset": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1,
          "description": "м: вынос квада за грань стены",
          "default": 0.06
        },
        "lit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "доля окон светящимися (ГПСЧ вывода, солёный шаг на каждый отсчёт)",
          "default": 0.4
        }
      },
      "additionalProperties": false,
      "description": "включатель + переопределение ряда окон: картинку выводит JsonMap, модуль главы этих чисел не содержит; по facadeMaterial работает надстройка byMaterial"
    },
    "sky": {
      "type": "object",
      "properties": {
        "sky": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          ],
          "description": "цвет неба (фон сцены)",
          "default": 11130101
        },
        "fog": {
          "type": "object",
          "properties": {
            "color": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет тумана",
              "default": 14084607
            },
            "near": {
              "type": "number",
              "minimum": 1,
              "description": "м: начало тумана",
              "default": 120
            },
            "far": {
              "type": "number",
              "minimum": 2,
              "description": "м: полное затемнение; правки этой пары — стиль главы, дефолта в брифе не требуется",
              "default": 460
            }
          },
          "additionalProperties": false,
          "description": "туман; секция мержится как { ...CONFIG.fog, ...sky.fog }"
        },
        "sun": {
          "type": "object",
          "properties": {
            "color": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет «луны»",
              "default": 16774368
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "яркость «луны»: единственный источник теней и яркость улицы (правило «достоинство луны, а не подсветок»)",
              "default": 2.4
            },
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "[x, y, z] мир: направление «луны»",
              "default": [
                150,
                200,
                -110
              ]
            }
          },
          "additionalProperties": false,
          "description": "мержится как { ...CONFIG.sun, ...sky.sun }"
        },
        "hemi": {
          "type": "object",
          "properties": {
            "sky": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет верхнего полусферического света",
              "default": 12575743
            },
            "ground": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              ],
              "description": "цвет нижнего полусферического света",
              "default": 4877107
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "яркость полусферического света",
              "default": 1
            }
          },
          "additionalProperties": false,
          "description": "мержится как { ...CONFIG.hemi, ...sky.hemi }"
        },
        "lights": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "minimum": 0,
              "maximum": 8,
              "description": "штук: настоящих источников в пуле; по наличию этой секции заводится NightLights, без неё глава живёт на «луне» (глава 12)",
              "default": 6
            },
            "reach": {
              "type": "number",
              "minimum": 1,
              "description": "м: радиус поиска опорных точек вокруг камеры",
              "default": 60
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "description": "м: подъём огня над опорной точкой",
              "default": 6
            },
            "spacing": {
              "type": "number",
              "minimum": 1,
              "description": "м: минимальное разнос огней",
              "default": 26
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 400,
              "description": "яркость одного огня пула",
              "default": 60
            }
          },
          "additionalProperties": false,
          "description": "пул src/night-lights.js переставляет count огней на map.openPositions() рядом с камерой"
        }
      },
      "additionalProperties": false,
      "description": "ночь главы как данные: слияние с дефолтами делает game.js, номеров глав карта не знает"
    },
    "properties": {
      "type": "object",
      "properties": {}
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "уникальный id дома; лоты генератора имеют форму `<id района>_<номер>`"
          },
          "name": {
            "type": "string",
            "description": "название для метки debugIds; по умолчанию — id"
          },
          "archetype": {
            "type": "string",
            "enum": [
              "box",
              "slab",
              "l",
              "u",
              "t",
              "cross",
              "bar_pair",
              "stepped2",
              "stepped3",
              "podium_tower"
            ],
            "description": "форма корпуса у генератора; в брифе — только подпись происхождения, в модуль не доезжает"
          },
          "buildingType": {
            "type": "string",
            "description": "тип дома (жилой, офис, торговый, башня и т.п.); сохраняется в модуле и используется движком для параметров фасада/окон"
          },
          "district": {
            "type": "string",
            "description": "id района, чью террасу и кадр получает лот; в модуль не доезжает"
          },
          "isEnterable": {
            "type": "boolean",
            "description": "false — корпус только декор фасада: этажи считаются ритмом, плит и маршей нет (потолок этажей тогда J.shellFloorsMax)",
            "default": true
          },
          "floorsCount": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "description": "эт: число этажей; вводимый дом ограничен J.enterableFloors (проверяется геометрией, а не этим максимумом)"
          },
          "floorHeight": {
            "type": "number",
            "minimum": 2.4,
            "maximum": 8,
            "description": "м: высота этажа; все отметки перекрытий и маршей считаются от baseY + floorsCount · floorHeight"
          },
          "baseY": {
            "type": "number",
            "description": "м: пол первого этажа; по умолчанию — опора грунта под центром дома"
          },
          "foundation": {
            "type": "string",
            "enum": [
              "podium",
              "terrain"
            ],
            "description": "вариант фундамента на неровной поверхности: podium — прямоугольный блок до нижней точки земли (уходит в склон); terrain — низ следует форме ландшафта. baseY в обоих случаях поднимается до наивысшей точки контакта (дом не зарывается)"
          },
          "facadeMaterial": {
            "type": "string",
            "description": "имя материала фасада; по нему ряды окон и вывесок берут надстройку из byMaterial",
            "default": "concrete"
          },
          "roof": {
            "type": "object",
            "properties": {
              "walkable": {
                "type": "boolean",
                "description": "true — кровля становится опорой (парапет J.parapetHeight по краю, маяк точки B может встать на неё); false — плита только картинка",
                "default": false
              },
              "parapet": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5,
                "description": "м: высота парапета ходовой кровли; 0 у non-walkable",
                "default": 0.9
              }
            },
            "additionalProperties": false,
            "description": "кровля: плита на союзе footprint минус шахты маршей"
          },
          "footprint": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "description": "м: мировая координата X"
                },
                "z": {
                  "type": "number",
                  "description": "м: мировая координата Z"
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false,
              "description": "точка в плане (метры)"
            },
            "description": "м: замкнутый полигон плана дома (ГПСЧ-сетка комнат вписывается в него)"
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "уникальный id комнаты"
                },
                "floor": {
                  "type": "number",
                  "minimum": 0,
                  "description": "эт: этаж комнаты (0 — пол на baseY)"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "office",
                    "corridor",
                    "hall",
                    "room",
                    "cafe",
                    "utility",
                    "lobby",
                    "market",
                    "warehouse"
                  ],
                  "description": "назначение: выводимый ряд витрин неона опирается на торговые типы"
                },
                "polygon": {
                  "type": "array",
                  "minItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "description": "м: мировая координата X"
                      },
                      "z": {
                        "type": "number",
                        "description": "м: мировая координата Z"
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ],
                    "additionalProperties": false,
                    "description": "точка в плане (метры)"
                  },
                  "description": "м: план комнаты; обязан лежать внутри footprint и не пересекать другие комнаты"
                },
                "connections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "string",
                        "description": "id комнаты или улицы/настила по ту сторону проёма"
                      },
                      "portalPosition": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number",
                            "description": "м: мировая координата X"
                          },
                          "y": {
                            "type": "number",
                            "description": "м: мировая отметка"
                          },
                          "z": {
                            "type": "number",
                            "description": "м: мировая координата Z"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false,
                        "description": "точка в мире (метры)"
                      },
                      "linkType": {
                        "type": "string",
                        "enum": [
                          "main_entrance",
                          "door",
                          "back_entrance"
                        ],
                        "description": "main_entrance / door / back_entrance: по нему нормализатор ставит проём и связывает внешний узел с решёткой дома"
                      }
                    },
                    "required": [
                      "target"
                    ],
                    "additionalProperties": false,
                    "description": "одна дверь: id цели за проёмом, точка портала и тип связки"
                  },
                  "description": "двери комнаты; проём (rect), а не точка портала, решает связность"
                }
              },
              "required": [
                "id",
                "floor",
                "type",
                "polygon"
              ],
              "additionalProperties": false,
              "description": "одна комната: этаж, назначение, план и двери"
            },
            "description": "комнаты дома: решётка пола и граф навигации строятся по ним"
          },
          "stairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "уникальный id марша"
                },
                "connectsFloors": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "эт: [с, по] — концы марша; цепочка обязана быть непрерывной от пола до кровли, иначе _pruneToSpawn отсечёт решётку"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "l_shape",
                    "spiral",
                    "ladder"
                  ],
                  "description": "straight / l_shape / spiral / ladder; беговая длина ограничена stairRun (J.maxStairSlope), у ladder — J.maxRise на проступь"
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "description": "м: мировая координата X"
                    },
                    "z": {
                      "type": "number",
                      "description": "м: мировая координата Z"
                    }
                  },
                  "required": [
                    "x",
                    "z"
                  ],
                  "additionalProperties": false,
                  "description": "точка в плане (метры)"
                },
                "rotation": {
                  "type": "number",
                  "description": "град: поворот марша в собственных осях дома",
                  "default": 0
                },
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м: ширина марша (для лестницы) или сторона шахты"
                    },
                    "length": {
                      "type": "number",
                      "minimum": 1,
                      "description": "м: беговая длина марша"
                    },
                    "height": {
                      "type": "number",
                      "description": "м: высота подъёма; по умолчанию шаг этажа"
                    }
                  },
                  "required": [
                    "width",
                    "length"
                  ],
                  "additionalProperties": false,
                  "description": "габарит шахты марша; для ladder по умолчанию J.ladderShaft × J.ladderShaft"
                }
              },
              "required": [
                "id",
                "connectsFloors",
                "type"
              ],
              "additionalProperties": false,
              "description": "один марш: какие этажи связывает, какой формы и где стоит его шахта"
            },
            "description": "марши дома"
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "description": "град: поворот дома вокруг центра габарита footprint; весь внутренний расчёт идёт в своих осях, в мире корпус держит OBB (габарит в коллизиях запретил бы невидимые стены по пустым углам)",
            "default": 0
          },
          "districtFrame": {
            "type": "object",
            "properties": {
              "cx": {
                "type": "number",
                "description": "м: центр поворота района"
              },
              "cz": {
                "type": "number",
                "description": "м: центр поворота района"
              },
              "yaw": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "description": "град: yaw района; терраса квартала собирается в осях района, а не мира"
              }
            },
            "required": [
              "cx",
              "cz",
              "yaw"
            ],
            "additionalProperties": false,
            "description": "кадр косого района (служебное поле генератора): в модуль не доезжает"
          }
        },
        "required": [
          "id",
          "floorsCount",
          "floorHeight",
          "footprint",
          "rooms"
        ],
        "additionalProperties": false,
        "description": "один дом: план footprint, этажность, комнаты с дверями и марши; отметки считаются от baseY"
      },
      "description": "авторские дома; кварталы генератора добавляются через `city`"
    },
    "cityforge": {
      "$ref": "./level-common.schema.json#/definitions/cityforge"
    },
    "generator": {
      "type": "object",
      "properties": {
        "generatorVersion": {
          "type": "string"
        },
        "seed": {
          "type": "number"
        },
        "deterministic": {
          "type": "boolean",
          "default": true
        },
        "stages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "layers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "type": "object",
            "properties": {}
          }
        },
        "budgets": {
          "type": "object",
          "properties": {}
        },
        "districts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "profileId": {
                "type": "string"
              },
              "geometry": {
                "type": "object",
                "properties": {}
              },
              "mask": {
                "type": "object",
                "properties": {}
              },
              "cells": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "properties": {}
                }
              },
              "priority": {
                "type": "number"
              },
              "overrides": {
                "type": "object",
                "properties": {}
              },
              "fallbackChain": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id"
            ],
            "description": "District declaration for generator stages/layer 3 (geometry|mask|cells as applicable)."
          }
        },
        "profiles": {
          "type": "object",
          "properties": {}
        },
        "catalogs": {
          "type": "object",
          "properties": {}
        },
        "refs": {
          "type": "object",
          "properties": {}
        },
        "policies": {
          "type": "object",
          "properties": {}
        }
      },
      "required": [
        "generatorVersion",
        "seed"
      ],
      "description": "v4 city generator manifest (IR/stages/districts/policies). Details refined in TASK-002+; open for forward-compatible fields."
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "metadata",
    "ground",
    "gameplay",
    "cityforge"
  ],
  "additionalProperties": false,
  "description": "CityForge v4 source level with district generator manifest (ADR-001)."
}
