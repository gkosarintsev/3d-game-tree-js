{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level brief v3 (kind: cityforge)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this brief schema: ./level-v3.schema.json."
    },
    "kind": {
      "type": "string",
      "enum": [
        "cityforge"
      ],
      "description": "CityForge source brief; entities are compiled into the level module."
    },
    "metadata": {
      "$ref": "./level-common.schema.json#/definitions/metadata"
    },
    "ground": {
      "$ref": "./level-common.schema.json#/definitions/ground"
    },
    "gameplay": {
      "$ref": "./level-common.schema.json#/definitions/gameplay"
    },
    "stream": {
      "$ref": "./level-common.schema.json#/definitions/stream"
    },
    "cityforge": {
      "$ref": "./level-common.schema.json#/definitions/cityforge"
    }
  },
  "required": [
    "kind",
    "metadata",
    "ground",
    "gameplay",
    "cityforge"
  ],
  "additionalProperties": false,
  "description": "CityForge source level from docs/world-format.md."
}
